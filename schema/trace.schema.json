        },
        "t": {
          "type": "number"
        },
        "agent": {
          "type": "string"
        },
        "type": {
          "const": "checkpoint"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "v",
        "seq",
        "t",
        "agent",
        "type",
        "turn",
        "context_tokens",
        "messages",
