      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "type": "number"
        },
        "agent": {
          "type": "string"
        },
        "type": {
          "const": "run_end"
        },
